# ============================================================================
# NIPPON CI/CD — environment template.
#   cp .env.sample .env   then edit .env with real values (NEVER commit .env)
#
# docker-compose.yml reads these variables to wire Jenkins to the target infra.
# ============================================================================

# --- NIPPON application repo (the source the pipeline checks out + builds) ---
NIPPON_REPO=https://github.com/kmoreti/nippon.git

# --- Local container registry that holds nippon/<service>:<tag> ---
# The k3s node resolves docker.io + this registry via /etc/rancher/k3s/registries.yaml
NIPPON_REGISTRY=192.168.68.120:5000

# --- k3s server the pipeline deploys to (SSH user@host) ---
K3S_NODE=kmoreti@192.168.68.129
# SSH key Jenkins uses to reach the node (mounted into the jenkins container)
K3S_SSH_KEY=./jenkins/id_rsa

# --- SonarQube metadata DB password ---
SONAR_DB_PASSWORD=sonarpass

# --- GitHub: personal access token used by Jenkins to clone NIPPON ---
# Generate at https://github.com/settings/tokens (scope: repo)
GITHUB_TOKEN=

# --- SonarQube token (created in the SonarQube UI -> My Account -> Security) ---
SONAR_TOKEN=
